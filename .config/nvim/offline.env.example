# Private target-machine profile. Copy to ~/.config/nvim-offline/env and edit.
NVIM_OFFLINE=1
NVIM_NEXUS_URL=http://nexus.company.example:8081

# Optional endpoint overrides. Normally they are derived from NVIM_NEXUS_URL.
# NVIM_GITHUB_RELEASE_BASE_URL=http://nexus.company.example:8081/repository/github.com
# NVIM_NEXUS_CORTEX_DEBUG_URL=http://nexus.company.example:8081/repository/marketplace/cortex-debug.vsix
# NVIM_NEXUS_PYPI_URL=http://nexus.company.example:8081/repository/pypi/simple
# NVIM_NEXUS_NPM_URL=http://nexus.company.example:8081/repository/npm
