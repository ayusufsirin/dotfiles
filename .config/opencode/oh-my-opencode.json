    "explore": {
      "model": "google/gemini-3.1-flash-lite",
      "fallback_models": [
        "openai/gpt-5.4-mini",
        "opencode/mimo-v2.6-flash-free"
      ]
    },
    "multimodal-looker": {
      "model": "google/gemini-3.1-pro-preview",
      "fallback_models": [
        "openai/gpt-6-sol"
      ]
    },
    "prometheus": {
      "model": "openai/gpt-6-sol",
      "fallback_models": [
