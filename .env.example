# Copy this file to .env. The test runner loads it automatically.
# Values explicitly exported by the caller override values from this file.

# Nexus serves package registries and HTTP release artifacts. It is not used
# for Git clones.
NVIM_NEXUS_URL=http://nexus.company.example:8081

# Docker receives the already-working Git configuration as a BuildKit secret.
# The file must be self-contained because includes outside it are not mounted.
NVIM_TEST_GIT_CONFIG_FILE=/home/user/.gitconfig

# Optional Docker-only endpoint overrides:
# NVIM_TEST_NEXUS_URL=http://another-nexus.company.example:8081
# NVIM_TEST_INTERNAL_CA_FILE=/secure/path/internal-ca.crt

# Docker execution settings.
NVIM_TEST_DOCKER_NETWORK=default
NVIM_TEST_PULL_BASES=1
NVIM_TEST_DEBIAN_IMAGE=debian:12
NVIM_TEST_UBUNTU_IMAGE=ubuntu:22.04
