# Copy this file to .env. The test runner loads it automatically.
# Values explicitly exported by the caller override values from this file.

# Canonical workstation and Docker endpoints. Nexus serves package registries
# and HTTP release artifacts; it is not used for Git clones.
NVIM_NEXUS_URL=http://nexus.company.example:8081

# Neovim builds direct <prefix>/<owner>/<repo>.git clone URLs from this value.
# Keep the trailing slash so the owner and repository path are preserved.
NVIM_GITHUB_GIT_MIRROR_BASE=https://gitlab.company.example/mirror/github.com/

# Optional internal CA and token files. Keep the token itself out of .env.
NVIM_GITLAB_CA_FILE=/usr/local/share/ca-certificates/company-internal-ca.crt
NVIM_TEST_GITLAB_TOKEN_FILE=

# Optional Docker-only endpoint overrides:
# NVIM_TEST_NEXUS_URL=http://another-nexus.company.example:8081
# NVIM_TEST_GITHUB_MIRROR_BASE=https://another-gitlab.company.example/mirror/github.com/
# NVIM_TEST_GITLAB_CA_FILE=/secure/path/alternate-ca.crt

# Docker execution settings.
NVIM_TEST_DOCKER_NETWORK=default
NVIM_TEST_PULL_BASES=1
NVIM_TEST_DEBIAN_IMAGE=debian:12
NVIM_TEST_UBUNTU_IMAGE=ubuntu:22.04
