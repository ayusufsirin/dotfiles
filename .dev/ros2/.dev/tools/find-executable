#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(
    cd "$(dirname "${BASH_SOURCE[0]}")" &&
    pwd
)"

source "$SCRIPT_DIR/ros-env.sh"

if [[ $# -ne 2 ]]; then
    echo "Usage: $0 <package> <executable>" >&2
    exit 2
fi

package="$1"
executable="$2"

prefix="$(ros2 pkg prefix "$package")"
path="$prefix/lib/$package/$executable"

if [[ ! -x "$path" ]]; then
    echo "Executable not found:" >&2
    echo "  package:    $package" >&2
    echo "  executable: $executable" >&2
    echo >&2
    echo "Known executables:" >&2
    ros2 pkg executables "$package" >&2 || true
    exit 1
fi

printf '%s\n' "$path"
